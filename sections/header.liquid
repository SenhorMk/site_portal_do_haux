            {%- else -%}
              <span class="h2">{{ shop.name }}</span>
            {%- endif -%}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    <form action="/search" method="get" class="haux-search-form small-hide" role="search">
      <button type="submit" class="haux-search-btn" aria-label="Buscar">
