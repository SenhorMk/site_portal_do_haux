          <a href="/collections/calcados">Calçados</a>
        </div>
      </li>
      <li><a href="/collections/all"><span>Produtos</span> </a></li>
      <li><a href="/collections/rapes">Rapés</a></li>
      <li><a href="/collections/kuripes">Kuripes</a></li>
      <li><a href="/pages/contato">Contato</a></li>
      <li><a href="/collections/defumadores"><span>Defumadores</span></a></li>
      <li><a href="/pages/institucional"><span>Institucional</span></a></li>
    </ul>
  </nav>

  <script>
    (function() {
      var items = document.querySelectorAll('#haux-nav-bar li');
      items.forEach(function(item) {
        var trigger = item.querySelector('span');
        var drop = item.querySelector('.haux-drop');
        if (!trigger || !drop) return;
        trigger.addEventListener('click', function(e) {
          e.stopPropagation();
          var isOpen = item.classList.contains('haux-open');
          items.forEach(function(i) { i.classList.remove('haux-open'); });
          if (!isOpen) item.classList.add('haux-open');
        });
      });
      document.addEventListener('click', function() {
        items.forEach(function(i) { i.classList.remove('haux-open'); });
      });
    })();
  </script>

