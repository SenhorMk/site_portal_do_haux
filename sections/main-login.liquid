{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Haux Custom Login Styles */
  .haux-login-wrapper {
    background-color: #f9f7f2; /* Soft earthy background */
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
    padding-left: 2rem;
    padding-right: 2rem;
  }
  .haux-login-card {
    background: #ffffff;
    max-width: 480px;
    width: 100%;
    padding: 4rem 3rem;
    border-radius: 16px;
    box-shadow: 0 12px 40px rgba(43, 58, 26, 0.08); /* Dark green tinted shadow */
    text-align: center;
    margin: 4rem 0;
  }
  .haux-login-card h1 {
    font-size: 2.6rem;
    margin-bottom: 1rem;
    color: var(--haux-terra, #2b3a1a);
    font-family: 'Frequen', sans-serif;
    letter-spacing: 0.05em;
  }
  .haux-login-card p.subtitle {
    color: #666;
    margin-bottom: 3rem;
    font-size: 1.5rem;
  }
  .haux-login-card .field {
    margin-top: 1.5rem;
  }
  .haux-login-card .field input {
    border-radius: 8px;
    border: 1px solid #e0e0e0;
    transition: all 0.3s ease;
  }
  .haux-login-card .field input:focus {
    border-color: var(--haux-terra, #2b3a1a);
    box-shadow: 0 0 0 1px var(--haux-terra, #2b3a1a);
  }
  .haux-login-card button {
    background-color: var(--haux-terra, #2b3a1a);
    color: #fff;
    border-radius: 8px;
    width: 100%;
    padding: 1.5rem;
    font-weight: bold;
    font-size: 1.6rem;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    transition: background-color 0.3s, transform 0.1s;
    border: none;
    cursor: pointer;
  }
  .haux-login-card button:hover {
    background-color: #1e2812;
  }
  .haux-login-card button:active {
    transform: scale(0.98);
  }
  .haux-login-card a {
    color: var(--haux-terra, #2b3a1a);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }
  .haux-login-card a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
  .haux-trust-badges {
    display: flex;
    justify-content: center;
    gap: 3rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #f0f0f0;
  }
  .haux-trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 1.2rem;
    color: #555;
    font-weight: 500;
  }
  .haux-trust-badge svg {
    width: 28px;
    height: 28px;
    margin-bottom: 0.8rem;
    color: var(--haux-terra, #2b3a1a);
  }
  
  /* Reset Dawn specific customer class margins to fit inside card */
  .haux-login-card.customer {
    margin-top: 0;
    margin-bottom: 0;
    max-width: 100%;
  }
  .haux-login-card.customer form {
    margin-top: 0;
  }
{%- endstyle -%}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div class="haux-login-wrapper section-{{ section.id }}-padding">
  <div class="haux-login-card customer login">
    
    <h1 id="recover" tabindex="-1">
      {{ 'customer.recover_password.title' | t }}
    </h1>
    <div>
      <p class="subtitle">
        {{ 'customer.recover_password.subtext' | t }}
      </p>

      {%- form 'recover_customer_password' -%}
        {% assign recover_success = form.posted_successfully? %}
        <div class="field">
          <input
            type="email"
            value=""
            name="email"
            id="RecoverEmail"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="RecoverEmail-email-error"
              autofocus
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
          <label for="RecoverEmail">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>
        {%- if form.errors -%}
          <small id="RecoverEmail-email-error" class="form__message">
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            {{ form.errors.messages.form }}
          </small>
        {%- endif -%}

        <button>
          {{ 'customer.login_page.submit' | t }}
        </button>

        <a href="#login">
          {{ 'customer.login_page.cancel' | t }}
        </a>
      {%- endform -%}
    </div>

    <h1 id="login" tabindex="-1">
      Acesse sua conta
    </h1>
    <div>
      <p class="subtitle">E sinta a energia da floresta com você.</p>
      {%- if recover_success == true -%}
        <h3 class="form__message" tabindex="-1" autofocus>
          <span class="svg-wrapper">
            {{- 'icon-success.svg' | inline_asset_content -}}
          </span>
          {{ 'customer.recover_password.success' | t }}
        </h3>
      {%- endif -%}
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <h2 class="form__message" tabindex="-1" autofocus>
            <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            {{ 'templates.contact.form.error_heading' | t }}
          </h2>
          {{ form.errors | default_errors }}
        {%- endif -%}

        {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
          <section name="sign-in-with-shop-provider">
            {{ shop | login_button: hide_button: hide_shop_login_button }}

            {%- unless hide_shop_login_button -%}
              <p>
                {{ 'customer.login_page.alternate_provider_separator' | t }}
              </p>
            {%- endunless -%}
          </section>
        {%- endif -%}

        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors contains 'form' %}
              aria-invalid="true"
            {% endif %}
            placeholder="{{ 'customer.login_page.email' | t }}"
          >
          <label for="CustomerEmail">
            {{ 'customer.login_page.email' | t }}
          </label>
        </div>

        {%- if form.password_needed -%}
          <div class="field">
            <input
              type="password"
              value=""
              name="customer[password]"
              id="CustomerPassword"
              autocomplete="current-password"
              {% if form.errors contains 'form' %}
                aria-invalid="true"
              {% endif %}
              placeholder="{{ 'customer.login_page.password' | t }}"
            >
            <label for="CustomerPassword">
              {{ 'customer.login_page.password' | t }}
            </label>
          </div>

          <a href="#recover" style="display: block; text-align: right; margin-top: 0.5rem; font-size: 1.3rem;">
            {{ 'customer.login_page.forgot_password' | t }}
          </a>
        {%- endif -%}

        <button>
          ENTRAR
        </button>

        <a href="{{ routes.account_register_url }}" style="display: block; text-align: center; margin-top: 1rem;">
          Não tem uma conta? <strong>Criar Conta</strong>
        </a>
      {%- endform -%}
    </div>

    <div class="haux-trust-badges">
      <div class="haux-trust-badge">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        Ambiente Seguro
      </div>
      <div class="haux-trust-badge">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        Dados Protegidos
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
