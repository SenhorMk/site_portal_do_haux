{% if section.settings.text != blank %}<div class="portal-announcement">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{% else %}<p>{{ section.settings.text | escape }}</p>{% endif %}</div>{% endif %}
{% schema %}
{
  "name": "Portal · Aviso",
  "tag": "section",
  "class": "portal-section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Condição comercial confirmada",
      "default": "[CONDIÇÃO COMERCIAL A DEFINIR]"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "presets": [
    {
      "name": "Portal · Aviso"
    }
  ]
}
{% endschema %}
