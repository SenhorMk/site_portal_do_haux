<div class="portal-categories portal-pad" id="categorias">
  <div class="portal-section-heading"><h2 class="portal-heading">{{ section.settings.heading | escape }}</h2>{% render 'portal-link', label: section.settings.label, url: section.settings.link %}</div>
  <div class="portal-categories__grid">
    {% for block in section.blocks %}
      {% liquid
        assign tile_tag = 'div'
        if block.settings.link != blank
          assign tile_tag = 'a'
        endif
      %}
      <{{ tile_tag }} {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %} class="portal-category portal-category--{{ block.settings.theme }}" {{ block.shopify_attributes }}>
        {% render 'portal-image', image: block.settings.image, mobile_image: block.settings.mobile_image, sizes:'(min-width: 1024px) 50vw, (min-width: 768px) 50vw, 100vw' %}
        {% render 'portal-glyph', type: block.settings.glyph, class: 'portal-category__glyph' %}
        <div class="portal-category__caption"><h3 class="portal-category__title">{{ block.settings.title | escape }}</h3>{% if block.settings.eyebrow != blank %}<span class="portal-eyebrow">{{ block.settings.eyebrow | escape }}</span>{% endif %}</div>
      </{{ tile_tag }}>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Portal · Categorias",
  "tag": "section",
  "class": "portal-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Categorias"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do link",
      "default": "Ver a loja inteira"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link",
      "default": "/collections/all"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "category",
      "name": "Categoria",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Imagem mobile",
          "info": "Opcional. Usada em telas de até 767 px; sem ela, vale a imagem principal."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Categoria"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destino"
        },
        {
          "type": "select",
          "id": "glyph",
          "label": "Glifo",
          "options": [
            {
              "value": "portal",
              "label": "Portal"
            },
            {
              "value": "flecha",
              "label": "Flecha"
            },
            {
              "value": "sopro",
              "label": "Sopro"
            },
            {
              "value": "ciclo",
              "label": "Ciclo"
            },
            {
              "value": "erva",
              "label": "Erva"
            },
            {
              "value": "estrela",
              "label": "Estrela"
            }
          ],
          "default": "portal"
        },
        {
          "type": "select",
          "id": "theme",
          "label": "Texto sobre a foto",
          "options": [
            {
              "value": "dark",
              "label": "Escuro"
            },
            {
              "value": "light",
              "label": "Claro"
            }
          ],
          "default": "dark"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Complemento curto"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Portal · Categorias"
    }
  ]
}
{% endschema %}
