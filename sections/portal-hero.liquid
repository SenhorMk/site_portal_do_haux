<div class="portal-hero portal-hero--{{ section.settings.alignment }} portal-hero--overlay-{{ section.settings.overlay }}">
  <div class="portal-hero__media">{% render 'portal-image', image: section.settings.image, mobile_image: section.settings.mobile_image, priority: true %}</div>
  {% if section.settings.graphics %}{% render 'portal-glyph', type: 'tapestry', class: 'portal-hero__tapestry' %}{% endif %}
  <div class="portal-hero__content">
    <h1 class="portal-heading portal-hero__heading">{{ section.settings.heading | escape }}</h1>
    <div class="portal-prose">{{ section.settings.text | escape | newline_to_br }}</div>
    <div class="portal-hero__actions">
      {% render 'portal-link', label: section.settings.label, url: section.settings.link, class: 'portal-button portal-button--warm' %}
      {% render 'portal-link', label: section.settings.secondary_label, url: section.settings.secondary_link, class: 'portal-hero__secondary' %}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Portal · Hero",
  "tag": "section",
  "class": "portal-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem mobile"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "A floresta atravessa o Portal"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Rapés, kuripes, tepis, defumadores, ervas e objetos de rito."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do link",
      "default": "Ver a loja"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Link secundário",
      "default": "Conhecer as ferramentas"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Destino secundário",
      "default": "#colecao"
    },
    {
      "type": "select",
      "id": "overlay",
      "label": "Contraste da imagem",
      "options": [
        {
          "value": "soft",
          "label": "Suave"
        },
        {
          "value": "balanced",
          "label": "Equilibrado"
        },
        {
          "value": "strong",
          "label": "Intenso"
        }
      ],
      "default": "balanced"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento",
      "options": [
        {
          "value": "left",
          "label": "Esquerda"
        },
        {
          "value": "center",
          "label": "Centro"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "graphics",
      "label": "Mostrar grafismo",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Portal · Hero"
    }
  ]
}
{% endschema %}
