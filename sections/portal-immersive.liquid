<portal-immersive class="portal-immersive" id="defumacao">
  <div class="portal-immersive__media">{% render 'portal-image', image: section.settings.image, mobile_image: section.settings.mobile_image %}</div>
  {% if section.settings.graphics %}{% render 'portal-glyph', type: 'sopro-wide', class: 'portal-immersive__sopro' %}{% endif %}
  <div class="portal-immersive__content">{% render 'portal-editorial-copy', content: section.settings, button_class: 'portal-button portal-button--warm' %}</div>
</portal-immersive>
{% schema %}
{
  "name": "Portal · Defumação",
  "tag": "section",
  "class": "portal-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem mobile"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Defumação"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Limpar o ar sem acender nada"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>[TEXTO A DEFINIR]</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do link",
      "default": "Ver defumadores"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link"
    },
    {
      "type": "checkbox",
      "id": "graphics",
      "label": "Mostrar gesto Sopro",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Portal · Defumação"
    }
  ]
}
{% endschema %}
