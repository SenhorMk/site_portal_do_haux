<portal-reveal class="portal-origin" id="origem">
  <div class="portal-origin__transition" aria-hidden="true"></div>
  {% if section.settings.graphics %}{% render 'portal-glyph', type: 'tapestry', class: 'portal-origin__tapestry' %}{% endif %}
  <div class="portal-split"><div class="portal-origin__media portal-reveal-media">{% render 'portal-image', image: section.settings.image, sizes: '(min-width: 768px) 50vw, 100vw' %}</div>
    <div class="portal-editorial-copy portal-reveal-copy">{% render 'portal-editorial-copy', content: section.settings %}</div>
  </div>
</portal-reveal>
{% schema %}
{
  "name": "Portal · Origem",
  "tag": "section",
  "class": "portal-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Nossa origem"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Quem prepara, assina"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>[TEXTO INSTITUCIONAL A DEFINIR]</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do link",
      "default": "Conhecer nossa origem"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link"
    },
    {
      "type": "checkbox",
      "id": "graphics",
      "label": "Mostrar grafismo",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Portal · Origem"
    }
  ]
}
{% endschema %}
