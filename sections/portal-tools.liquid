<portal-reveal class="portal-tools portal-tools--{{ section.settings.order }}" id="colecao">
  <div class="portal-tools__grid"><div class="portal-tools__media portal-reveal-media">{% render 'portal-image', image: section.settings.image, mobile_image: section.settings.mobile_image, sizes: '(min-width: 1024px) 60vw, 100vw' %}</div>
    <div class="portal-editorial-copy portal-reveal-copy">
      {% if section.settings.graphics %}{% render 'portal-glyph', type: 'filete', class: 'portal-tools__glyph portal-draw' %}{% endif %}
      {% render 'portal-editorial-copy', content: section.settings, button_class: 'portal-button portal-button--dark' %}
      {% if section.settings.secondary != blank %}<p class="portal-secondary">{{ section.settings.secondary | escape }}</p>{% endif %}
    </div>
  </div>
</portal-reveal>
{% schema %}
{
  "name": "Portal · Ferramentas",
  "tag": "section",
  "class": "portal-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagem mobile"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Coleção · Ferramentas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Kuripes e tepis feitos um a um"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>[TEXTO A DEFINIR]</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Texto do link",
      "default": "Ver a coleção"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Destino do link"
    },
    {
      "type": "text",
      "id": "secondary",
      "label": "Informação complementar confirmada"
    },
    {
      "type": "select",
      "id": "order",
      "label": "Posição da imagem",
      "options": [
        {
          "value": "image-first",
          "label": "À esquerda"
        },
        {
          "value": "text-first",
          "label": "À direita"
        }
      ],
      "default": "image-first"
    },
    {
      "type": "checkbox",
      "id": "graphics",
      "label": "Mostrar grafismo",
      "default": true
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Portal · Ferramentas"
    }
  ]
}
{% endschema %}
