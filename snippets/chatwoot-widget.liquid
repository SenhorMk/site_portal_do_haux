{%- unless request.design_mode -%}
  <script>
    window.chatwootSettings = { locale: 'pt_BR', position: 'right', type: 'standard', launcherTitle: 'Fale com a gente' };
    (function (d, t) {
      var BASE_URL = 'https://orbita-chat.tail02fea0.ts.net';
      var g = d.createElement(t), s = d.getElementsByTagName(t)[0];
      g.src = BASE_URL + '/packs/js/sdk.js';
      g.async = true;
      g.defer = true;
      s.parentNode.insertBefore(g, s);
      g.onload = function () {
        window.chatwootSDK.run({ websiteToken: '2qfyFjzAGB9c5VEgde8UUk32', baseUrl: BASE_URL });
      };
    })(document, 'script');
  </script>
{%- endunless -%}
