{% doc %}
  Portal-only assets. Self-hosted approved typography; no external font requests.
{% enddoc %}
{% style %}
  @font-face {
    font-family: 'Fraunces';
    src: url('{{ 'portal-fraunces-latin.woff2' | asset_url }}') format('woff2');
    font-weight: 300 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Work Sans';
    src: url('{{ 'portal-work-sans-latin.woff2' | asset_url }}') format('woff2');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
  }
{% endstyle %}
{{ 'portal-haux.css' | asset_url | stylesheet_tag }}
<script src="{{ 'portal-haux.js' | asset_url }}" defer="defer"></script>
<noscript>
  {% style %}
    .portal .no-js-hidden { display: none; }
    .portal-header details[open] > .menu-drawer { visibility: visible; transform: none; }
    .portal-header .menu-drawer__submenu { position: static; visibility: visible; transform: none; }
    .portal-header details[open] > .search-modal { opacity: 1; visibility: visible; }
  {% endstyle %}
</noscript>
