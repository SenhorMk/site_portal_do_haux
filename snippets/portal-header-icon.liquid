{% doc %}
  Outline icons for the Portal header controls (search, account, cart), drawn on one 24px grid
  with the same 1.6 stroke so the three controls read as a set.

  @param {string} name - 'search', 'account' or 'cart'
{% enddoc %}
<svg class="portal-header-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.4 15.4 20.5 20.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c.9-3.7 3.8-6 7.5-6s6.6 2.3 7.5 6"/>
    {%- when 'cart' -%}
      <path d="M2.5 3.5h2.3a1 1 0 0 1 1 .8L8.3 15.7a1.5 1.5 0 0 0 1.5 1.2h7.9a1.5 1.5 0 0 0 1.5-1.2l1.5-7.4a.8.8 0 0 0-.8-1H6.3"/><circle cx="10" cy="20.2" r="1.3"/><circle cx="17.4" cy="20.2" r="1.3"/>
  {%- endcase -%}
</svg>
