{% doc %}
  Line sigil, redrawn from the label art.
  @param {string} linha - guardiao, luz, harmonia, purificacao
  @param {string} [class] - Optional presentation class
{% enddoc %}
<svg class="portal-linha-sigilo {{ class }}" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d="m60 4 56 56-56 56L4 60Z"/>
  <path d="m60 15 45 45-45 45-45-45Z" stroke-width=".7"/>
  {% case linha %}
    {% when 'guardiao' %}
      <path d="M43 76V55a17 17 0 0 1 34 0v21M38 76h44"/>
      <path d="m60 53 9 9-9 9-9-9Z"/>
      <path d="M60 58.500 63.500 62 60 65.500 56.500 62Z" fill="currentColor"/>
      <path d="M60 34v-9m-3 4 3-4 3 4M60 84v9m-3-4 3 4 3-4"/>
    {% when 'luz' %}
      <circle cx="60" cy="60" r="9"/>
      <path d="M60 44v-8m0 48v-8m16-16h8m-48 0h8m27.300-11.300 5.600-5.600M43 77l5.700-5.700m22.600 0L77 77M43 43l5.700 5.700"/>
      <path d="m60 28 3 3-3 3-3-3ZM60 86l3 3-3 3-3-3Z"/>
      <path d="m27 60 3-3 3 3-3 3ZM87 60l3-3 3 3-3 3Z"/>
    {% when 'harmonia' %}
      <path d="m60 37 11 11-11 11-11-11ZM60 61l11 11-11 11-11-11Z"/>
      <path d="M31 60h58"/>
      <circle cx="31" cy="60" r="2.200" fill="currentColor"/>
      <circle cx="89" cy="60" r="2.200" fill="currentColor"/>
      <path d="m60 25 3 3-3 3-3-3Z"/>
      <path d="M60 89v8m-3-4 3 4 3-4"/>
    {% else %}
      <path d="m40 44 20 20 20-20M46 37l14 14 14-14"/>
      <circle cx="60" cy="72" r="1.800" fill="currentColor"/>
      <path d="M38 78h44"/>
      <path d="M60 84v12m-3-8 3-4 3 4"/>
      <path d="M60 24v10m-4-6 4-4 4 4"/>
  {% endcase %}
</svg>
