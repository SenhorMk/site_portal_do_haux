{% comment %}
  Shared mega-menu / mobile-drawer category entries for Produtos and Eventos.

  Produtos, in order of preference:
  1. A Shopify navigation menu with the handle "menu-produtos" (Admin › Conteúdo › Menus): each top-level
     link is a category and its nested links are the subcategories. The store owner edits it there.
  2. The default structure below. Each destination is the configured Shopify URL (categories only), then
     an existing collection, then a real product search for the term. No dead links, no fake products.
{% endcomment %}
{%- liquid
  assign product_menu = linklists['menu-produtos']
  assign use_menu = false
  if kind == 'products' and product_menu.links.size > 0
    assign use_menu = true
  endif

  if kind == 'events'
    assign tree = 'BIBLIOTECA DE FOTOS^nav_fotos^^^^biblioteca-de-fotos|RELATOS^nav_relatos^^^^relatos|CALENDÁRIO^nav_calendario^^^^calendario'
  else
    capture tree
      echo 'VESTUÁRIO^nav_vestuario^roupas^roupa^Bolsas~bolsas~bolsa;Ponchos & blusas~ponchos-e-blusas~poncho;Camisetas & camisas~camisetas-e-camisas~camiseta;Calças, shorts & bermudas~calcas-shorts-e-bermudas~calça;Acessórios~acessorios~acessório'
      echo '|MEDICINAS^nav_medicinas^rapes^rapé^Rapé~rapes~rapé;Kumbaia~kumbaia~kumbaia'
      echo '|DEFUMAÇÃO^nav_defumacao^defumador^defumador^Defumador líquido~defumador~defumador;Defumação completa~defumacao-completa~defumação'
      echo '|INCENSÁRIO^nav_incensario^incensarios^incensário^Incensos~incensos~incenso;Base para incensos~base-para-incensos~incensário'
      echo '|ARTESANATOS^nav_artesanatos^artesanatos^artesanato^Decorações~decoracoes~decoração;Instrumentos musicais~instrumentos-musicais~instrumento'
      echo '|AROMATERAPIA^^aromaterapia^aromaterapia^Colônias~colonias~colônia;Sprays de ambiente~sprays-de-ambiente~spray;Óleos essenciais~oleos-essenciais~óleo essencial;Velas aromáticas~velas-aromaticas~vela;Escalda-pés~escalda-pes~escalda'
      echo '|PRODUTOS NATURAIS^nav_naturais^produtos-naturais^natural^Ervas & chás~ervas-e-chas~ervas;Saúde & beleza~saude-e-beleza~beleza;Especiarias~especiarias~especiaria'
      echo '|TABACARIA^nav_tabacaria^tabacaria^tabaco^Tabaco in natura~tabaco-in-natura~tabaco;Kuripes (aplicadores)~kuripes~kuripe;Cachimbos~cachimbos~cachimbo'
    endcapture
  endif
  assign product_search = routes.search_url | append: '?type=product&q='
  assign rows = tree | split: '|'
  if use_menu
    assign rows = '' | split: '|'
    for link in product_menu.links
      assign category_title = link.title | upcase
      render 'portal-menu-category', title: category_title, url: link.url, links: link.links, mobile: mobile
    endfor
  endif

  for row in rows
    assign cell = row | split: '^'
    assign category_title = cell[0]
    assign destination = blank
    if cell[1] != blank
      assign destination = menu_settings[cell[1]]
    endif
    if destination == blank and cell[2] != blank
      assign category_collection = collections[cell[2]]
      if category_collection != blank
        assign destination = category_collection.url
      else
        assign destination = product_search | append: cell[3] | url_encode | prepend: ''
        assign encoded = cell[3] | url_encode
        assign destination = product_search | append: encoded
      endif
    endif
    if destination == blank and cell[5] != blank
      assign category_page = pages[cell[5]]
      if category_page != blank
        assign destination = category_page.url
      endif
    endif

    assign subs = ''
    if cell[4] != blank
      assign entries = cell[4] | split: ';'
      for entry in entries
        assign part = entry | split: '~'
        assign sub_collection = collections[part[1]]
        if sub_collection != blank
          assign sub_url = sub_collection.url
        else
          assign encoded = part[2] | url_encode
          assign sub_url = product_search | append: encoded
        endif
        assign subs = subs | append: part[0] | append: '~' | append: sub_url
        unless forloop.last
          assign subs = subs | append: ';'
        endunless
      endfor
    endif

    render 'portal-menu-category', title: category_title, url: destination, subs: subs, mobile: mobile
  endfor
-%}
