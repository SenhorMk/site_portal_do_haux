{% comment %}
  Portal editorial navigation: five fixed top-level items. The two mega menus share
  category entries with the native Shopify mobile drawer. Visual back faces are aria-hidden.
{% endcomment %}
<nav class="header__inline-menu portal-nav" aria-label="Menu principal">
  <ul class="list-menu list-menu--inline" role="list">
    <li>
      <a id="PortalNav-Inicio" href="{{ routes.root_url }}" class="header__menu-item list-menu__item link focus-inset portal-nav__item"{% if template.name == 'index' %} aria-current="page"{% endif %}>
        <span class="portal-nav__face portal-nav__face--front">INÍCIO</span>
        <span class="portal-nav__face portal-nav__face--back" aria-hidden="true"><span class="portal-nav__fill"></span>INÍCIO</span>
      </a>
    </li>
    <li class="portal-nav__mega-root">
      <header-menu>
        <details id="Details-PortalNav-Produtos">
          <summary id="PortalNav-Produtos" class="header__menu-item list-menu__item link focus-inset portal-nav__item" aria-controls="PortalMega-Produtos">
            <span class="portal-nav__face portal-nav__face--front">PRODUTOS {{- 'icon-caret.svg' | inline_asset_content -}}</span>
            <span class="portal-nav__face portal-nav__face--back" aria-hidden="true"><span class="portal-nav__fill"></span>PRODUTOS {{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </summary>
          <div id="PortalMega-Produtos" class="portal-nav__panel portal-nav__panel--mega" tabindex="-1">
            <div class="portal-mega__heading">
              <p class="portal-mega__eyebrow">Explore o Portal</p>
              <h2 class="portal-mega__title">Produtos</h2>
              <p class="portal-mega__description">Cada caminho tem sua natureza. Escolha uma categoria para descobrir o que há no Portal.</p>
            </div>
            <ul class="portal-mega__items" role="list">
              {% render 'portal-menu-items', kind: 'products', menu_settings: menu_settings, mobile: false %}
            </ul>
          </div>
        </details>
      </header-menu>
    </li>
    <li class="portal-nav__mega-root">
      <header-menu>
        <details id="Details-PortalNav-Eventos">
          <summary id="PortalNav-Eventos" class="header__menu-item list-menu__item link focus-inset portal-nav__item" aria-controls="PortalMega-Eventos">
            <span class="portal-nav__face portal-nav__face--front">EVENTOS {{- 'icon-caret.svg' | inline_asset_content -}}</span>
            <span class="portal-nav__face portal-nav__face--back" aria-hidden="true"><span class="portal-nav__fill"></span>EVENTOS {{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </summary>
          <div id="PortalMega-Eventos" class="portal-nav__panel portal-nav__panel--mega portal-nav__panel--events" tabindex="-1">
            <div class="portal-mega__heading">
              <p class="portal-mega__eyebrow">Memórias e encontros</p>
              <h2 class="portal-mega__title">Eventos</h2>
              <p class="portal-mega__description">Registros, histórias e próximos encontros do nosso caminho.</p>
            </div>
            <ul class="portal-mega__items" role="list">
              {% render 'portal-menu-items', kind: 'events', menu_settings: menu_settings, mobile: false %}
            </ul>
          </div>
        </details>
      </header-menu>
    </li>
    <li>
      <a id="PortalNav-Blog" href="{{ blog_url }}" class="header__menu-item list-menu__item link focus-inset portal-nav__item"{% if template.name == 'blog' or template.name == 'article' %} aria-current="page"{% endif %}>
        <span class="portal-nav__face portal-nav__face--front">BLOG</span>
        <span class="portal-nav__face portal-nav__face--back" aria-hidden="true"><span class="portal-nav__fill"></span>BLOG</span>
      </a>
    </li>
    <li>
      {%- if menu_settings.nav_outros != blank -%}
        <a id="PortalNav-Outros" href="{{ menu_settings.nav_outros }}" class="header__menu-item list-menu__item link focus-inset portal-nav__item">
          <span class="portal-nav__face portal-nav__face--front">OUTROS</span>
          <span class="portal-nav__face portal-nav__face--back" aria-hidden="true"><span class="portal-nav__fill"></span>OUTROS</span>
        </a>
      {%- else -%}
        <span class="portal-nav__item portal-nav__item--pending" title="Em preparação">OUTROS</span>
      {%- endif -%}
    </li>
  </ul>
</nav>
