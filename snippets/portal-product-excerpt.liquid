{% doc %}
  Short description beside the buy box. Long descriptions are trimmed and linked to the
  tabs in portal-product-details, which always carry the full text.
{% enddoc %}
{%- liquid
  assign portal_plain = product.description | strip_html | strip_newlines | strip
-%}
{%- if portal_plain.size > 240 -%}
  <div class="portal-product__excerpt">
    <p>{{ portal_plain | truncate: 220 }}</p>
    <a class="portal-link" href="#PortalProductAbout">{{ 'portal.product.read_more' | t }}</a>
  </div>
{%- elsif portal_plain != blank -%}
  <div class="portal-product__excerpt rte">{{ product.description }}</div>
{%- endif -%}
